package main

import (
	"fmt"
	"math"
)

func main() {
	var n int
	fmt.Println("Enter the value of N")
	fmt.Scan(&n)
	a := make([]float64, n)
	var sum float64
	for i := 0; i < n; i++ {
		fmt.Scan(&a[i])
		sum += a[i]
	}
	mean := sum / float64(n)
	var v float64
	for i := 0; i < n; i++ {
		d := a[i] - mean
		v += d * d
	}
	sd := math.Sqrt(v / float64(n))
	fmt.Println("Sd is ", sd)
}
