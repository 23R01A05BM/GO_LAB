package main

import "fmt"

func main() {
	var n int
	fmt.Println("Enter the value of N")
	fmt.Scan(&n)

	a := make([]int, n)
	seen := make(map[int]bool)
	res := []int{}
	for i := 0; i < n; i++ {
		fmt.Scan(&a[i])
		if !seen[a[i]] {
			seen[a[i]] = true
			res = append(res, a[i])
		}
	}
	fmt.Println(res)
}
